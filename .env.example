# Copy to .env (same directory as composer.json) and fill in.
# Used by functional tests and record-observations-fixtures when run inside wp-env tests-cli.
#
# The file must exist on the HOST at wp-ai-telemetry/.env — it is mounted into the container
# with the plugin at wp-content/plugins/wp-ai-telemetry/.env

OPENAI_API_KEY=

# --- OTLP export (WordPress plugin → backend) ---
# Base URL only: the plugin appends /v1/traces (protobuf over HTTP).
#
# Langfuse Cloud examples:
#   EU: https://cloud.langfuse.com/api/public/otel
#   US: https://us.cloud.langfuse.com/api/public/otel
# Auth: OTLP_AUTH_USERNAME = Langfuse public key (pk-lf-...)
#       OTLP_AUTH_PASSWORD = Langfuse secret key (sk-lf-...)
OTLP_ENDPOINT=

# Same credentials are sent as HTTP Basic Auth on OTLP POSTs and on the public REST checks below.
OTLP_AUTH_USERNAME=
OTLP_AUTH_PASSWORD=

# --- Public REST API (tests only: read traces/observations) ---
# Base URL of the UI/API origin — NO /api/public suffix. Tests call:
#   {OTEL_BACKEND_PUBLIC_BASE_URL}/api/public/traces
#   {OTEL_BACKEND_PUBLIC_BASE_URL}/api/public/observations
#
# Langfuse Cloud examples:
#   EU: https://cloud.langfuse.com
#   US: https://us.cloud.langfuse.com
OTEL_BACKEND_PUBLIC_BASE_URL=
