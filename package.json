{
	"name": "wp-ai-telemetry",
	"private": true,
	"license": "GPL-2.0-or-later",
	"devDependencies": {
		"@wordpress/env": "^10.27.0"
	},
	"scripts": {
		"wp-env": "wp-env",
		"lint-php": "wp-env run cli --env-cwd=wp-content/plugins/wp-ai-telemetry composer lint",
		"test-php": "wp-env run tests-cli --env-cwd=wp-content/plugins/wp-ai-telemetry ./vendor/bin/phpunit -c phpunit.xml.dist --verbose",
		"test-php-multisite": "wp-env run tests-cli --env-cwd=wp-content/plugins/wp-ai-telemetry ./vendor/bin/phpunit -c tests/phpunit/multisite.xml --verbose"
	}
}
